#include <SDL2/SDL.h>
#include <SDL2/SDL_image.h>
#include <string>

///---------------
/// Prueba de Font en SDL. PAra compilar:
/// g++ -o testSDLFont testSDLFont.cpp `sdl2-config --cflags --libs | sed 's/-mwindows//g'` -lSDL2_image
///---------------

const int CHAR_WIDTH = 32;
const int CHAR_HEIGHT = 48;
const int CHARS_PER_ROW = 16; // ajusta según el atlas bitmap

SDL_Texture* LoadFontTexture(SDL_Renderer* renderer, const char* filename) {
    SDL_Surface* surf = IMG_Load(filename);
    if (!surf) {
        SDL_Log("Error loading font: %s", IMG_GetError());
        return nullptr;
    }
    SDL_Texture* tex = SDL_CreateTextureFromSurface(renderer, surf);
    SDL_FreeSurface(surf);
    return tex;
}

void DrawBitmapText(SDL_Renderer* renderer, SDL_Texture* fontTex, const std::string& text, int x, int y) {
    for (size_t i = 0; i < text.size(); ++i) {
        unsigned char c = text[i];
        if (c < 32 || c > 127) c = '?'; // caracteres fuera de rango

        int glyphIndex = c - 32;
        int sx = (glyphIndex % CHARS_PER_ROW) * CHAR_WIDTH;
        int sy = (glyphIndex / CHARS_PER_ROW) * CHAR_HEIGHT;
        SDL_Rect src = { sx, sy, CHAR_WIDTH, CHAR_HEIGHT };
        SDL_Rect dst = { x + int(i)*CHAR_WIDTH, y, CHAR_WIDTH, CHAR_HEIGHT };
        SDL_RenderCopy(renderer, fontTex, &src, &dst);
    }
}

int SDL_main(int argc, char* argv[]) {
    SDL_Init(SDL_INIT_VIDEO);

    SDL_Window* window = SDL_CreateWindow("Bitmap Font PCX SDL2", SDL_WINDOWPOS_CENTERED, SDL_WINDOWPOS_CENTERED, 800, 600, 0);
    SDL_Renderer* renderer = SDL_CreateRenderer(window, -1, SDL_RENDERER_ACCELERATED);

    SDL_Log("Prueba de log... inicio.");
    SDL_LogError (1,"Otra prueba de log. Este es de error.");

    SDL_Texture* fontTex = LoadFontTexture(renderer, "prueba-font.pcx");

    bool running = true;
    while(running) {
        SDL_Event e;
        while(SDL_PollEvent(&e)) {
            if (e.type == SDL_QUIT) running = false;
        }
        SDL_SetRenderDrawColor(renderer, 40, 40, 40, 255);
        SDL_RenderClear(renderer);

        DrawBitmapText(renderer, fontTex, "Hola Mundo!", 60, 80);
        DrawBitmapText(renderer, fontTex, "0123456789&", 60, 180);

        SDL_RenderPresent(renderer);
        SDL_Delay(16);
    }
    SDL_DestroyTexture(fontTex);
    SDL_DestroyRenderer(renderer);
    SDL_DestroyWindow(window);
    IMG_Quit();
    SDL_Quit();
    return 0;
}
