#include <SDL2/SDL.h>

int main(int, char**) {
    SDL_Init(SDL_INIT_VIDEO);
    SDL_Window* window = SDL_CreateWindow("Click para cambiar color",
        SDL_WINDOWPOS_CENTERED, SDL_WINDOWPOS_CENTERED, 800, 600, SDL_WINDOW_SHOWN);
    SDL_Renderer* renderer = SDL_CreateRenderer(window, -1, SDL_RENDERER_ACCELERATED);

    SDL_Rect square = { 100, 100, 200, 200 };
    bool isRed = true;
    bool running = true;
    SDL_Event event;

    while (running) {
        while (SDL_PollEvent(&event)) {
            if (event.type == SDL_QUIT) {
                running = false;
            } else if (event.type == SDL_MOUSEBUTTONDOWN) {
                int x = event.button.x;
                int y = event.button.y;
                // Comprobar si el clic está dentro del cuadrado
                if (x >= square.x && x <= square.x + square.w &&
                    y >= square.y && y <= square.y + square.h) {
                    isRed = !isRed; // cambiar color
                }
            } else if (event.type == SDL_MOUSEWHEEL) {
                SDL_SetRenderDrawColor (renderer, 0, 0, 255, 255);
                SDL_Rect prueba = {320, 100, 200, 200};
                SDL_RenderFillRect (renderer, &prueba);
                SDL_RenderPresent(renderer);
                SDL_Delay (16);
            }
            if (event.type == SDL_MOUSEBUTTONDOWN && event.button.button == SDL_BUTTON_LEFT) {
                int mx = event.button.x, my = event.button.y;
                // Verifica si click está sobre alguna opción
                // for (size_t i = 0; i < menu.items.size(); ++i) {
                //     int oy = y + i * altoOpcion;
                //     if (mx >= x && mx < x + ancho && my >= oy && my < oy + altoOpcion) {
                //         seleccion = int(i);
                //         activo = false;
                //     }
                // }
                // // Click fuera, cancela
                // if (!(mx >= x && mx < x + ancho && my >= y && my < y + altoOpcion * menu.items.size())) {
                //     activo = false;
                // }
            }
            //if (event.type == SDL_QUIT) { activo = false; }
        }

        // Limpiar pantalla (fondo negro)
        SDL_SetRenderDrawColor(renderer, 128,128, 128, 255);
        SDL_RenderClear(renderer);

        // Dibujar el cuadrado con el color actual
        if (isRed) {
            SDL_SetRenderDrawColor(renderer, 255, 0, 0, 255); // rojo
        } else {
            SDL_SetRenderDrawColor(renderer, 0, 255, 0, 255); // verde
        }
        SDL_RenderFillRect(renderer, &square);

        SDL_RenderPresent(renderer);
        SDL_Delay(16);  // Aproximado ~60 FPS
    }

    SDL_DestroyRenderer(renderer);
    SDL_DestroyWindow(window);
    SDL_Quit();
    return 0;
}

